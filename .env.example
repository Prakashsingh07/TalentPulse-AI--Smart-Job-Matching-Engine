# TalentPulse AI Production Environment Configuration

# ----------------------------
# General & Server Ports
# ----------------------------
NODE_ENV=production
PORT=5000
VITE_API_URL=http://localhost:5000/api

# ----------------------------
# Database Connection String
# ----------------------------
# For SQL Server:
DEFAULT_CONNECTION=Server=localhost,1433;Database=TalentPulseDB;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;MultipleActiveResultSets=true
# For SQLite Fallback:
# DEFAULT_CONNECTION=Data Source=talentpulse.db

# ----------------------------
# JWT Security Settings
# ----------------------------
JWT_SECRET=TalentPulse_Super_Secret_Production_Key_2026_Enterprise_Secure_Hash
JWT_ISSUER=TalentPulseAPI
JWT_AUDIENCE=TalentPulseClients
